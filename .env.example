# Environment Configuration for Wan S2V API Server

# =====================================================
# Cloudflare R2 Configuration (REQUIRED)
# =====================================================

# Your R2 endpoint URL (replace account-id with your actual account ID)
R2_ENDPOINT_URL=https://account-id.r2.cloudflarestorage.com

# R2 API credentials
R2_ACCESS_KEY_ID=your_r2_access_key_here
R2_SECRET_ACCESS_KEY=your_r2_secret_key_here

# R2 region (usually 'auto' for Cloudflare R2)
R2_REGION=auto

# Public domain for generated URLs (optional)
# If you have a custom domain for your R2 bucket
R2_PUBLIC_DOMAIN=https://your-public-domain.r2.dev

# Default bucket name for input/output files 
DEFAULT_BUCKET_NAME=dolphintest

# =====================================================
# Server Configuration
# =====================================================

# Local workspace directory for temporary processing files
WORKSPACE_DIR=workspace

# Whether to cleanup local files after processing (true/false)
CLEANUP_WORKSPACE=true

# Checkpoint directory for the Wan model
WAN_CKPT_DIR=./Wan2.2-S2V-14B/

# =====================================================
# Flask Server Configuration
# =====================================================

# Server host (use 0.0.0.0 for external access)
FLASK_HOST=127.0.0.1

# Server port
FLASK_PORT=5000

# Debug mode (true/false) - disable in production
FLASK_DEBUG=false

# Log level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# =====================================================
# Processing Configuration  
# =====================================================

# Maximum processing timeout per request (seconds)
PROCESSING_TIMEOUT=1800

# Default values for generation parameters
DEFAULT_SIZE=832*480
DEFAULT_SAMPLE_GUIDE_SCALE=4.0
DEFAULT_SAMPLE_STEPS=20

# =====================================================
# Security Configuration
# =====================================================

# Maximum request size (for file uploads if implemented later)
MAX_CONTENT_LENGTH=104857600  # 100MB

# Rate limiting (requests per minute per IP)
RATE_LIMIT_PER_MINUTE=10